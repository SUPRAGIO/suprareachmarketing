---
// Comparison.astro
---

<section class="compare">
  <div class="wrap">
    <div class="compare-top">
      <span class="eyebrow reveal">The difference</span>
      <h2 class="compare-headline reveal reveal-delay-1">
        EVERYONE SAYS<br/> THEY'RE THE BEST.
        <span class="serif">Here's what actually separates us.</span>
      </h2>
      <p class="compare-sub reveal reveal-delay-2">Put us side by side with any other agency and see what you're actually signing up for.</p>
    </div>

    <div class="compare-grid reveal">
      <!-- Them -->
      <div class="compare-col">
        <div class="compare-col-header">
          <div class="compare-col-icon bad">
            <svg viewBox="0 0 14 14"><path d="M2 2l10 10M12 2L2 12"/></svg>
          </div>
          <span class="compare-col-name">The Other Guys</span>
        </div>
        <ul class="compare-list">
          <li class="compare-item">
            <span class="c-icon bad"><svg viewBox="0 0 12 12"><path d="M2 2l8 8M10 2L2 10"/></svg></span>
            <span class="c-text">Promise rankings, deliver reports full of metrics that don't matter</span>
          </li>
          <li class="compare-item">
            <span class="c-icon bad"><svg viewBox="0 0 12 12"><path d="M2 2l8 8M10 2L2 10"/></svg></span>
            <span class="c-text">Monthly retainers whether it works or not — $1,000–$3,000/month</span>
          </li>
          <li class="compare-item">
            <span class="c-icon bad"><svg viewBox="0 0 12 12"><path d="M2 2l8 8M10 2L2 10"/></svg></span>
            <span class="c-text">Lock you into 6–12 month contracts before you see a single result</span>
          </li>
          <li class="compare-item">
            <span class="c-icon bad"><svg viewBox="0 0 12 12"><path d="M2 2l8 8M10 2L2 10"/></svg></span>
            <span class="c-text">Your account gets handed to someone who just Googled "local SEO"</span>
          </li>
          <li class="compare-item">
            <span class="c-icon bad"><svg viewBox="0 0 12 12"><path d="M2 2l8 8M10 2L2 10"/></svg></span>
            <span class="c-text">Ghost you once the invoice clears</span>
          </li>
        </ul>
      </div>

      <!-- Us -->
      <div class="compare-col dark">
        <div class="compare-col-header">
          <div class="compare-col-icon good">
            <svg viewBox="0 0 14 14"><path d="M2 7l4 4 6-8"/></svg>
          </div>
          <span class="compare-col-name"><span class="brand">Supra</span>Reach Marketing</span>
        </div>
        <ul class="compare-list">
          <li class="compare-item">
            <span class="c-icon good"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-6"/></svg></span>
            <span class="c-text">Top 3 in 90 days — or your full $1,500 back. In writing.</span>
          </li>
          <li class="compare-item">
            <span class="c-icon good"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-6"/></svg></span>
            <span class="c-text">$1,500 one-time flat fee. No recurring charges. Done.</span>
          </li>
          <li class="compare-item">
            <span class="c-icon good"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-6"/></svg></span>
            <span class="c-text">No contract. No lock-in. Results do the talking.</span>
          </li>
          <li class="compare-item">
            <span class="c-icon good"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-6"/></svg></span>
            <span class="c-text">Your account is built and managed by the expert — not passed off</span>
          </li>
          <li class="compare-item">
            <span class="c-icon good"><svg viewBox="0 0 12 12"><path d="M2 6l3 3 5-6"/></svg></span>
            <span class="c-text">Weekly ranking updates — you know exactly where you stand every week</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
