---
// Hero.astro
---

<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-glow-2"></div>

  <div class="hero-content">
    <h1 class="hero-headline">
      DAMN<br/>
      <span class="line-red">GOOD</span><br/>
      MARKETING.
      <span class="line-serif">for businesses that are done being invisible.</span>
    </h1>

    <div class="hero-bottom">
      <div class="hero-descriptor">
        <p>
          <strong>Top 3 on Google Maps in 90 days, or we give you every dollar back.</strong>
          No retainers. No contracts. No junior employees touching your account.
          Just a proven system run by someone who actually knows what they're doing.
        </p>
        <div class="hero-ctas">
          <a href="#cta" class="btn btn-primary">
            Get Free Analysis
            <svg class="arrow-icon" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a href="#process" class="btn btn-ghost">See How It Works</a>
        </div>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-number">90<span class="accent">D</span></div>
          <div class="hero-stat-label">Guaranteed timeline</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-number">$<span class="accent">0</span></div>
          <div class="hero-stat-label">Monthly retainers</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-number">100<span class="accent">%</span></div>
          <div class="hero-stat-label">Money back if we miss</div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>
