---
// CTASection.astro
---

<section class="cta-final" id="cta">
  <div class="cta-glow"></div>
  <div class="wrap cta-final-inner">
    <div class="cta-final-badge reveal">
      <span class="dot"></span>
      Free · No Commitment · No Sales Pitch
    </div>

    <h2 class="cta-final-headline reveal reveal-delay-1">
      FIND OUT WHY<br/>
      YOUR COMPETITORS<br/>
      <span class="red">RANK ABOVE YOU.</span>
      <span class="serif">We'll show you. For free.</span>
    </h2>

    <p class="cta-final-body reveal reveal-delay-2">
      Tell us about your business. We'll record a custom 5-minute video showing you exactly what's holding you back on Google — and precisely how we'd fix it.
    </p>
    <p class="cta-final-note reveal reveal-delay-2">Takes you 2 minutes. Costs you nothing.</p>

    <div class="cta-final-btns reveal reveal-delay-3">
      <a href="https://form.suprareachmarketing.com" class="btn btn-primary" style="font-size:14px; padding:18px 40px;">
        Get Your Free Analysis
        <svg class="arrow-icon" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
    </div>

    <p class="cta-final-assurance reveal reveal-delay-3">
      <span>No obligation</span> No contracts <span>•</span> No retainers <span>•</span> Just results
    </p>
  </div>
</section>
