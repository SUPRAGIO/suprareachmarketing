---
// CTASection.astro
---

<section class="cta-final" id="cta">
  <div class="cta-glow"></div>
  <div class="wrap">
    <div class="cta-final-inner">
      <div class="cta-final-badge"><div class="dot"></div> Free Analysis Available</div>
      <h2 class="cta-final-headline reveal">
FIND OUT<br>WHY YOUR <span class="red">COMPETITORS</span><br>RANK AB<span class="red">OVE</span> YOU.
<span class="serif">We'll show you. For free.</span>
</h2>
      <p class="cta-final-body reveal">We'll pull your Google Maps ranking data, analyze your top 3 competitors, and tell you exactly what's holding you back.</p>
      <p class="cta-final-note reveal">No retainer. No pitch. Just data.</p>
      <div class="cta-final-btns reveal">
      <a href="/free-analysis" class="btn btn-primary" style="font-size:14px; padding:18px 40px;">
        Get Your Free Analysis
        <svg class="arrow-icon" viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
      </a>
      </div>
      <p class="cta-final-assurance reveal">
        90-DAY GUARANTEE<span>&|</span>$NO MONTHLY RETAINERS<span>&|</span>$1,500 FLAT FEE
      </p>
    </div>
  </div>
</section>
